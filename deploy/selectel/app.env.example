# Copy the existing values from BotHost. Never send them through chat.
SCHEDULE_BOT_TOKEN=PASTE_FROM_BOTHOST
SCHEDULE_BOT_USERNAME=TEMLI_bot
SCHEDULE_OWNER_ID=PASTE_FROM_BOTHOST
TELEGRAM_PROXY_URL=PASTE_FROM_BOTHOST

# Public HTTPS endpoint on the Selectel VPS.
SCHEDULE_TIMEZONE=Europe/Moscow
SCHEDULE_WEBAPP_URL=https://temli.135-106-173-105.sslip.io/app/
SCHEDULE_WEBAPP_ORIGIN=https://temli.135-106-173-105.sslip.io
TEMLI_PUBLIC_URL=https://temli.135-106-173-105.sslip.io
TEMLI_DEPLOYMENT_ID=temli-selectel-candidate

# Generated independently on the VPS during installation.
TEMLI_BOT_ENCRYPTION_KEY=GENERATED_ON_SERVER
TEMLI_CONSENT_LEDGER_HMAC_KEY=GENERATED_ON_SERVER
TEMLI_DSR_HASH_KEY=GENERATED_ON_SERVER

# Consent enforcement remains off during owner-only testing. Enable it before
# inviting real teachers after the final document versions are published.
TEMLI_CONSENT_ENFORCEMENT=false
TEMLI_USER_AGREEMENT_ID=temli-user-agreement
TEMLI_USER_AGREEMENT_VERSION=DRAFT
TEMLI_USER_AGREEMENT_SHA256=REPLACE_WHEN_PUBLISHED
TEMLI_PERSONAL_DATA_CONSENT_ID=temli-personal-data-consent
TEMLI_PERSONAL_DATA_CONSENT_VERSION=DRAFT
TEMLI_PERSONAL_DATA_CONSENT_SHA256=REPLACE_WHEN_PUBLISHED

TEMLI_REPLICA_INTERVAL_SECONDS=21600
TEMLI_REPLICA_RETENTION=60
